{
  "module": "holonight-qt",
  "cpp": true,
  "qml": true,
  "languages": [
    "cpp",
    "qml",
    "python",
    "bash"
  ],
  "dependencies": [
    {
      "module": "holonight-config",
      "package": "HoloNightConfig",
      "source_variable": "HOLONIGHT_CONFIG_SOURCE"
    }
  ],
  "qml_modules": [
    "Holonight.Core",
    "Holonight.Controls",
    "Holonight"
  ],
  "wayland": false,
  "required_tools": [
    "patchelf"
  ],
  "external_dependencies": [
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Core",
        "Gui",
        "Widgets",
        "Qml",
        "Quick",
        "QuickControls2",
        "QuickShapes",
        "Svg",
        "GuiPrivate",
        "QuickPrivate",
        "QuickControls2Private",
        "QuickTemplates2Private"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "WaylandClient"
      ],
      "feature": "BUILD_WAYLAND"
    },
    {
      "id": "qt-wayland",
      "scope": [
        "build"
      ],
      "feature": "BUILD_WAYLAND"
    },
    {
      "id": "wayland",
      "scope": [
        "build"
      ],
      "feature": "BUILD_WAYLAND"
    },
    {
      "id": "wayland-scanner",
      "scope": [
        "build"
      ],
      "feature": "BUILD_WAYLAND"
    },
    {
      "id": "syntax",
      "scope": [
        "build"
      ],
      "feature": "BUILD_SYNTAX_THEMES"
    },
    {
      "id": "patchelf",
      "scope": [
        "test"
      ]
    },
    {
      "id": "compiler",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "cmake",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "ninja",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "pkgconf",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "git",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "python",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "gtest",
      "scope": [
        "test"
      ],
      "targets": [
        "GTest::gtest"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "Test",
        "QmlPrivate"
      ]
    },
    {
      "id": "fonts",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "mime",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "qt5",
      "scope": [
        "test"
      ],
      "feature": "BUILD_QT5_PROBES"
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "OpenGL"
      ]
    }
  ],
  "external_features": {
    "BUILD_WAYLAND": true,
    "BUILD_SYNTAX_THEMES": true,
    "BUILD_QT5_PROBES": false
  }
}
