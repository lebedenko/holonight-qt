set(artifacts "@HOLONIGHT_QT5_PLUGIN_ROOT@/styles/libholonight.so" "@HOLONIGHT_QT5_PLUGIN_ROOT@/platformthemes/libqholonight.so")
foreach(artifact IN LISTS artifacts)
  execute_process(COMMAND readelf -d "${artifact}" OUTPUT_VARIABLE dynamic RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR dynamic MATCHES "Qt6" OR NOT dynamic MATCHES "Qt5")
    message(FATAL_ERROR "Invalid Qt 5 linkage: ${artifact}\n${dynamic}")
  endif()
endforeach()
file(GLOB qt6_artifacts "@CMAKE_BINARY_DIR@/lib/qt6/plugins/styles/*.so" "@CMAKE_BINARY_DIR@/lib/qt6/plugins/platformthemes/*.so")
foreach(artifact IN LISTS qt6_artifacts)
  execute_process(COMMAND readelf -d "${artifact}" OUTPUT_VARIABLE dynamic RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR dynamic MATCHES "Qt5")
    message(FATAL_ERROR "Invalid Qt 6 linkage: ${artifact}\n${dynamic}")
  endif()
endforeach()
