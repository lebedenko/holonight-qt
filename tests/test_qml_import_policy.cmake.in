set(test_root "@CMAKE_CURRENT_BINARY_DIR@/qml-import-policy-test")
file(REMOVE_RECURSE "${test_root}")
file(MAKE_DIRECTORY "${test_root}/positive" "${test_root}/negative")

file(WRITE "${test_root}/positive/Runtime.qml"
  "import QtQuick.Controls\nButton { text: \"runtime\" }\n")
file(WRITE "${test_root}/positive/Explicit.qml"
  "import Holonight\nButton { text: \"compile-time\" }\n")
file(WRITE "${test_root}/positive/Basic.qml"
  "import QtQuick.Controls.Basic as Basic\nBasic.Button { text: \"basic\" }\n")

execute_process(
  COMMAND bash "@CMAKE_SOURCE_DIR@/scripts/check-qml-import-policy.sh" "${test_root}/positive"
  RESULT_VARIABLE positive_result
  OUTPUT_VARIABLE positive_output
  ERROR_VARIABLE positive_error
)
if(NOT positive_result EQUAL 0)
  message(FATAL_ERROR "Valid QML import-policy fixtures failed:\n${positive_output}\n${positive_error}")
endif()

file(WRITE "${test_root}/negative/Missing.qml" "import QtQuick\nButton {}\n")
file(WRITE "${test_root}/negative/Parent.qml" "import Holonight\nItem {}\n")
file(WRITE "${test_root}/negative/Child.qml" "import QtQuick\nButton {}\n")

execute_process(
  COMMAND bash "@CMAKE_SOURCE_DIR@/scripts/check-qml-import-policy.sh" "${test_root}/negative"
  RESULT_VARIABLE negative_result
  OUTPUT_VARIABLE negative_output
  ERROR_VARIABLE negative_error
)
if(negative_result EQUAL 0)
  message(FATAL_ERROR "Invalid QML import-policy fixtures unexpectedly passed")
endif()
foreach(expected "Missing.qml" "Parent.qml" "Child.qml")
  string(FIND "${negative_error}" "${expected}" expected_index)
  if(expected_index EQUAL -1)
    message(FATAL_ERROR "Import-policy failure did not identify ${expected}:\n${negative_error}")
  endif()
endforeach()

# Enforce the migrated scope independently of historical fixed-style fixtures.
file(MAKE_DIRECTORY "${test_root}/positive/controls" "${test_root}/positive/core")
file(WRITE "${test_root}/positive/controls/Runtime.qml"
  "import QtQuick.Controls as C\nC.Button { C.ToolTip.visible: true; display: C.Button.TextOnly }\n")
file(WRITE "${test_root}/positive/core/Label.qml"
  "import QtQuick.Templates as T\nT.Label {}\n")
execute_process(COMMAND bash "@CMAKE_SOURCE_DIR@/scripts/check-qml-import-policy.sh" "${test_root}/positive"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Migrated positive fixtures failed: ${error}")
endif()
foreach(case IN ITEMS style basic unqualified attached enum missing-runtime namespace core-runtime core-style)
  set(case_root "${test_root}/${case}")
  file(MAKE_DIRECTORY "${case_root}/controls" "${case_root}/core")
  set(path "${case_root}/controls/Invalid.qml")
  if(case STREQUAL "style")
    set(source "import Holonight as H\nH.Button {}")
  elseif(case STREQUAL "basic")
    set(source "import QtQuick.Controls.Basic as C\nC.Button {}")
  elseif(case STREQUAL "unqualified")
    set(source "import QtQuick.Controls as C\nButton {}")
  elseif(case STREQUAL "attached")
    set(source "import QtQuick.Controls as C\nC.Button { ToolTip.visible: true }")
  elseif(case STREQUAL "enum")
    set(source "import QtQuick.Controls as C\nC.Button { display: Button.TextOnly }")
  elseif(case STREQUAL "missing-runtime")
    set(source "import QtQuick\nC.Button {}")
  elseif(case STREQUAL "namespace")
    set(source "import QtQuick.Controls as Controls\nControls.Button {}")
  elseif(case STREQUAL "core-runtime")
    set(path "${case_root}/core/Invalid.qml")
    set(source "import QtQuick.Controls as C\nC.Label {}")
  else()
    set(path "${case_root}/core/Invalid.qml")
    set(source "import Holonight as H\nH.Label {}")
  endif()
  file(WRITE "${path}" "${source}\n")
  execute_process(COMMAND bash "@CMAKE_SOURCE_DIR@/scripts/check-qml-import-policy.sh" "${case_root}"
      RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "Invalid.qml")
    message(FATAL_ERROR "Migrated ${case} fixture was not rejected: ${error}")
  endif()
endforeach()
