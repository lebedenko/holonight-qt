set(test_root "@CMAKE_CURRENT_BINARY_DIR@/package-install-test")
set(install_destdir "${test_root}/destdir")
set(install_prefix "${install_destdir}/usr")
set(consumer_source "${test_root}/consumer")
set(consumer_build "${test_root}/build")

file(REMOVE_RECURSE "${test_root}")
file(MAKE_DIRECTORY "${consumer_source}")

set(qml_root "${install_prefix}/@QT6_INSTALL_QML@")
set(legacy_qml_root "${qml_root}/holonight")
file(MAKE_DIRECTORY "${legacy_qml_root}")
file(WRITE "${legacy_qml_root}/qmldir" "module holonight\nlegacy sentinel\n")
file(WRITE "${legacy_qml_root}/sentinel.txt" "administrator-owned legacy content\n")
file(GLOB_RECURSE legacy_files_before RELATIVE "${legacy_qml_root}" "${legacy_qml_root}/*")
file(SHA256 "${legacy_qml_root}/qmldir" legacy_qmldir_hash_before)
file(SHA256 "${legacy_qml_root}/sentinel.txt" legacy_sentinel_hash_before)

execute_process(
  COMMAND "@CMAKE_COMMAND@" -E env "DESTDIR=${install_destdir}"
          "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix /usr
  RESULT_VARIABLE install_result
  OUTPUT_VARIABLE install_output
  ERROR_VARIABLE install_error
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "Install failed:\n${install_output}\n${install_error}")
endif()

set(combined_install_output "${install_output}\n${install_error}")
string(FIND "${combined_install_output}" "Stale lowercase HoloNight QML module detected" warning_index)
if(warning_index EQUAL -1)
  message(FATAL_ERROR "Install did not warn about the stale lowercase module:\n${combined_install_output}")
endif()
file(SHA256 "${legacy_qml_root}/qmldir" legacy_qmldir_hash_after)
file(SHA256 "${legacy_qml_root}/sentinel.txt" legacy_sentinel_hash_after)
file(GLOB_RECURSE legacy_files_after RELATIVE "${legacy_qml_root}" "${legacy_qml_root}/*")
if(NOT legacy_qmldir_hash_before STREQUAL legacy_qmldir_hash_after
    OR NOT legacy_sentinel_hash_before STREQUAL legacy_sentinel_hash_after
    OR NOT legacy_files_before STREQUAL legacy_files_after)
  message(FATAL_ERROR "Install modified the administrator-owned lowercase QML tree")
endif()

file(WRITE "${consumer_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(holonight_package_consumer LANGUAGES CXX)
find_package(HolonightQt REQUIRED COMPONENTS Core Controls)
find_package(Qt6 REQUIRED COMPONENTS Qml Quick QuickControls2 Widgets)
if(NOT TARGET HolonightQt::Core)
  message(FATAL_ERROR "HolonightQt::Core is missing")
endif()
if(NOT TARGET HolonightQt::Controls)
  message(FATAL_ERROR "HolonightQt::Controls is missing")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/main.cpp" [==[
#include <QApplication>
#include <QQmlComponent>
#include <QQmlEngine>
#include <QStyle>
#include <memory>

int main(int argc, char** argv) {
  QApplication app(argc, argv);
  if (QString::fromLatin1(app.style()->metaObject()->className()) != QStringLiteral("HoloniightStyle")) {
    return 2;
  }
  QQmlEngine engine;
  QQmlComponent component(&engine);
  component.setData(R"(
    import QtQuick
    import QtQuick.Controls
    Item {
      Button { objectName: "hybridButton"; text: "Hybrid" }
    }
  )", QUrl{});
  if (!component.isReady()) {
    qWarning().noquote() << component.errorString();
    return 3;
  }
  std::unique_ptr<QObject> root(component.create());
  return root ? 0 : 4;
}
]==])
add_executable(package_consumer "${CMAKE_CURRENT_BINARY_DIR}/main.cpp")
target_link_libraries(package_consumer PRIVATE HolonightQt::Core HolonightQt::Controls
  Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Widgets)
]=])

execute_process(
  COMMAND "@CMAKE_COMMAND@"
          -S "${consumer_source}"
          -B "${consumer_build}"
          "-DCMAKE_PREFIX_PATH=${install_prefix}"
  RESULT_VARIABLE configure_result
  OUTPUT_VARIABLE configure_output
  ERROR_VARIABLE configure_error
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "Consumer configure failed:\n${configure_output}\n${configure_error}")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${consumer_build}"
  RESULT_VARIABLE consumer_build_result
  OUTPUT_VARIABLE consumer_build_output
  ERROR_VARIABLE consumer_build_error
)
if(NOT consumer_build_result EQUAL 0)
  message(FATAL_ERROR "Consumer build failed:\n${consumer_build_output}\n${consumer_build_error}")
endif()

foreach(relative_path
    "Holonight/Core/qmldir"
    "Holonight/Core/holonight_core_qml.qmltypes"
    "Holonight/Core/@CMAKE_SHARED_MODULE_PREFIX@holonight_core_qml@CMAKE_SHARED_MODULE_SUFFIX@"
    "Holonight/Core/HnControlSize.qml"
    "Holonight/Core/HnControlMetrics.qml"
    "Holonight/Core/HnIcon.qml"
    "Holonight/Controls/qmldir"
    "Holonight/Controls/holonight_controls_qml.qmltypes"
    "Holonight/Controls/@CMAKE_SHARED_MODULE_PREFIX@holonight_controls_qml@CMAKE_SHARED_MODULE_SUFFIX@"
    "Holonight/Controls/HnSearchField.qml"
    "Holonight/Controls/HnHeaderBar.qml"
    "Holonight/Controls/HnIconComboBox.qml"
    "Holonight/Controls/HnTextArea.qml"
    "Holonight/Controls/HnFormField.qml"
    "Holonight/Controls/HnSettingsRow.qml"
    "Holonight/Controls/HnSectionHeader.qml"
    "Holonight/Controls/HnEmptyState.qml"
    "Holonight/Controls/HnLoadingState.qml"
    "Holonight/Controls/HnSelectableDelegate.qml"
    "Holonight/Controls/HnNavigationDelegate.qml"
    "Holonight/Controls/HnListDelegate.qml"
    "Holonight/Controls/HnCardDelegate.qml"
    "Holonight/Controls/HnActionDelegate.qml"
    "Holonight/Controls/HnStatusIndicator.qml"
    "Holonight/Controls/HnKeyHint.qml"
    "Holonight/Controls/HnPanelHeader.qml"
    "Holonight/Controls/HnSegmentedControl.qml"
    "Holonight/Controls/HnChoiceCard.qml"
    "Holonight/Controls/HnActionBar.qml"
    "Holonight/Controls/HnIconButton.qml"
    "Holonight/Controls/HnSeparator.qml"
    "Holonight/Controls/HnApplicationWindow.qml"
    "Holonight/Controls/HnSurfaceFrame.qml"
    "Holonight/Controls/assets/search.svg"
    "Holonight/Controls/assets/clear.svg"
    "Holonight/Controls/assets/more-vertical.svg"
    "Holonight/Controls/assets/edit.svg"
    "Holonight/Controls/assets/delete.svg"
    "Holonight/Controls/assets/folder.svg"
    "Holonight/Controls/assets/paperclip.svg"
    "Holonight/Controls/assets/wrench.svg"
    "Holonight/Controls/assets/send.svg")
  if(NOT EXISTS "${qml_root}/${relative_path}")
    message(FATAL_ERROR "Installed QML artifact is missing: ${qml_root}/${relative_path}")
  endif()
endforeach()

foreach(relative_path
    "Holonight/HnIcon.qml"
    "Holonight/HnApplicationWindow.qml"
    "Holonight/HnSurfaceFrame.qml")
  if(EXISTS "${qml_root}/${relative_path}")
    message(FATAL_ERROR "Legacy shared-type artifact is still installed: ${qml_root}/${relative_path}")
  endif()
endforeach()

file(READ "${qml_root}/Holonight/qmldir" style_qmldir)
string(FIND "${style_qmldir}" "import QtQuick.Controls.Basic\n" basic_fallback_index)
if(basic_fallback_index EQUAL -1)
  message(FATAL_ERROR "Holonight does not declare the Basic fallback:\n${style_qmldir}")
endif()
foreach(legacy_type HnIcon HnApplicationWindow HnSurfaceFrame)
  string(FIND "${style_qmldir}" "${legacy_type}" legacy_type_index)
  if(NOT legacy_type_index EQUAL -1)
    message(FATAL_ERROR "Holonight still exports ${legacy_type}:\n${style_qmldir}")
  endif()
endforeach()

file(READ "${qml_root}/Holonight/Controls/qmldir" controls_qmldir)
foreach(control_type IN ITEMS @HOLONIGHT_CONTROLS_PUBLIC_TYPES@)
  string(FIND "${controls_qmldir}" "${control_type} 1.0 ${control_type}.qml" public_type_index)
  if(public_type_index EQUAL -1)
    message(FATAL_ERROR "Holonight.Controls does not publicly export ${control_type}:\n${controls_qmldir}")
  endif()
endforeach()
string(FIND "${controls_qmldir}"
  "internal HnSelectableDelegate HnSelectableDelegate.qml" internal_type_index)
if(internal_type_index EQUAL -1)
  message(FATAL_ERROR "HnSelectableDelegate is not marked internal:\n${controls_qmldir}")
endif()

file(WRITE "${test_root}/import-check.qml" [=[
import QtQuick
import QtQuick.Controls
Item {
  Button { id: button; text: "Installed" }
  CheckBox { id: checkBox }
  ComboBox { id: comboBox; model: ["One"] }
  ItemDelegate { id: itemDelegate; text: "Installed" }
  Menu { id: menu; MenuItem { text: "Installed" } }
  ProgressBar { id: progressBar; value: 0.5 }
  RadioButton { id: radioButton }
  ScrollBar { id: scrollBar }
  ScrollView { id: scrollView; Item { width: 10; height: 10 } }
  Slider { id: slider; value: 0.5 }
  SpinBox { id: spinBox; value: 1 }
  Switch { id: switchControl }
  TabBar { id: tabBar; TabButton { text: "Installed" } }
  TextArea { id: textArea; text: "Installed" }
  TextField { id: textField; text: "Installed" }
  ToolTip { id: toolTip; text: "Installed" }
  Component.onCompleted: {
    if (button.implicitHeight !== 32 || textField.implicitHeight !== 32
        || !checkBox || !comboBox || !itemDelegate || !menu || !progressBar || !radioButton
        || !scrollBar || !scrollView || !slider || !spinBox || !switchControl || !tabBar
        || !textArea || !toolTip)
      throw new Error("Installed HoloNight runtime style was not applied to every control")
    Qt.quit()
  }
}
]=])

execute_process(
  COMMAND "@CMAKE_COMMAND@" -E env
          "QT_QPA_PLATFORM=offscreen"
          "QT_QPA_PLATFORMTHEME="
          "QT_STYLE_OVERRIDE="
          "QT_QUICK_CONTROLS_STYLE=Holonight"
          "QML_IMPORT_PATH=${qml_root}"
          "@HOLONIGHT_QML_EXECUTABLE@"
          -I "${qml_root}"
          "${test_root}/import-check.qml"
  RESULT_VARIABLE qml_result
  OUTPUT_VARIABLE qml_output
  ERROR_VARIABLE qml_error
)
if(NOT qml_result EQUAL 0)
  message(FATAL_ERROR "Installed QML import failed:\n${qml_output}\n${qml_error}")
endif()
if(qml_error MATCHES "(QQml|ReferenceError|TypeError|[Ww]arning)")
  message(FATAL_ERROR "Installed QML consumer emitted diagnostics:\n${qml_error}")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" -E env
          "QT_QPA_PLATFORM=offscreen"
          "QT_QPA_PLATFORMTHEME=holonight"
          "QT_QUICK_CONTROLS_STYLE=Holonight"
          "QT_STYLE_OVERRIDE="
          "QT_PLUGIN_PATH=${install_prefix}/@QT6_INSTALL_PLUGINS@"
          "QML_IMPORT_PATH=${qml_root}"
          "${consumer_build}/package_consumer"
  RESULT_VARIABLE hybrid_result
  OUTPUT_VARIABLE hybrid_output
  ERROR_VARIABLE hybrid_error
)
if(NOT hybrid_result EQUAL 0)
  message(FATAL_ERROR "Installed hybrid consumer failed (${hybrid_result}):\n${hybrid_output}\n${hybrid_error}")
endif()
if(hybrid_error MATCHES "(QQml|ReferenceError|TypeError|[Ww]arning)")
  message(FATAL_ERROR "Installed hybrid consumer emitted diagnostics:\n${hybrid_error}")
endif()

set(lint_check [=[
import QtQuick
import Holonight.Controls

Item {
]=])
set(lint_index 0)
foreach(control_type IN ITEMS @HOLONIGHT_CONTROLS_PUBLIC_TYPES@)
  string(APPEND lint_check
    "  property Component type${lint_index}: Component { ${control_type} {} }\n")
  math(EXPR lint_index "${lint_index} + 1")
endforeach()
string(APPEND lint_check "}\n")
file(WRITE "${test_root}/lint-check.qml" "${lint_check}")

set(qt_qml_root "@HOLONIGHT_SYSTEM_QT_QML_DIR@")

execute_process(
  COMMAND "@CMAKE_COMMAND@" -E env
          "QML_IMPORT_PATH="
          "@HOLONIGHT_QMLLINT_EXECUTABLE@"
          --bare
          --max-warnings 0
          -I "${qml_root}"
          -I "${qt_qml_root}"
          "${test_root}/lint-check.qml"
  RESULT_VARIABLE qmllint_result
  OUTPUT_VARIABLE qmllint_output
  ERROR_VARIABLE qmllint_error
)
if(NOT qmllint_result EQUAL 0)
  message(FATAL_ERROR "Installed QML lint failed:\n${qmllint_output}\n${qmllint_error}")
endif()
