@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick QuickControls2 Svg)
find_dependency(HoloNightConfig CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/HolonightQtTargets.cmake")

if("Wayland" IN_LIST HolonightQt_FIND_COMPONENTS)
  find_dependency(Qt6 REQUIRED COMPONENTS WaylandClient)
  find_dependency(Wayland REQUIRED COMPONENTS Client)
  include("${CMAKE_CURRENT_LIST_DIR}/HolonightQtWaylandTargets.cmake" OPTIONAL RESULT_VARIABLE wayland_targets)
  if(wayland_targets)
    set(HolonightQt_Wayland_FOUND TRUE)
  else()
    set(HolonightQt_Wayland_FOUND FALSE)
  endif()
endif()

foreach(component IN LISTS HolonightQt_FIND_COMPONENTS)
  if(component STREQUAL "Core" AND TARGET HolonightQt::Core)
    set(HolonightQt_Core_FOUND TRUE)
  elseif(component STREQUAL "Controls" AND TARGET HolonightQt::Controls)
    set(HolonightQt_Controls_FOUND TRUE)
  elseif(component STREQUAL "Theme" AND TARGET HolonightQt::Theme)
    set(HolonightQt_Theme_FOUND TRUE)
  elseif(component STREQUAL "Wayland" AND TARGET HolonightQt::Wayland)
    set(HolonightQt_Wayland_FOUND TRUE)
  else()
    set(HolonightQt_${component}_FOUND FALSE)
  endif()
endforeach()

check_required_components(HolonightQt)
